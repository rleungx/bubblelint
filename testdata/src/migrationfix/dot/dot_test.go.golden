package dot

import (
	"testing"
	. "testing/synctest"
	"time"
)

func TestMigration(t *testing.T) {
	Test(t, func(t *testing.T) {
		done := make(chan struct{})
		go func() { close(done) }()
		time.Sleep(time.Second) // want "ST100:"
		<-done
	})
}

func existing(t *testing.T) { Test(t, func(t *testing.T) {}) }
